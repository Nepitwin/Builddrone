{
    "cleanup": [
        {
            "module": "filesystem.cleanup",
            "args": {
                "folders": [
                    "binaries",
                    "dist",
                    "build",
                    "obj",
                    "example",
                    "example_copy",
                    "example_copy_files"
                ],
                "files": [
                    "my_file.json",
                    "my_file.yaml"
                ]
            }
        }
    ],
    "copy": [
        {
            "module": "filesystem.copy",
            "args": {
                "source": "example",
                "destination": "example_copy"
            }
        },
        {
            "module": "filesystem.copy",
            "args": {
                "source": "example",
                "files": "*.jpg",
                "destination": "example_copy_files"
            }
        }
    ]
}
