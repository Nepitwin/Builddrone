{
    "upload": [
        {
            "module": "python.run",
            "args": {
                "source": "main.py"
            }
        },
        {
            "module": "appveyor.upload.tests",
            "args": {
                "sources": [
                    {"file": "results/xunit.xml", "type": "xunit"},
                    {"file": "results/junit.xml", "type": "junit"}
                ]
            }
        }
    ],
    "artifacts": [
        {
            "module": "archiver",
            "args": {
                "filename": "results.zip",
                "folders": ["results"]
            }
        },
        {
            "module": "appveyor.upload.artifact",
            "args": {
                "files": ["results.zip"]
            }
        }
    ],
    "cleanup": [
        {
            "module": "filesystem.cleanup",
            "args": {
                "folders": ["results"],
                "files": ["results.zip"]
            }
        }
    ]
}
